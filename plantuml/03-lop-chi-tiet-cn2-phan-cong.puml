@startuml
' Bieu do lop day du pha phan tich - Chuc nang 2: Phan cong nhan vien phuc vu
' Da them ChooseSlotView + lop Slot theo nhan xet "thieu lop slot ky thuat".

hide circle
skinparam classAttributeIconSize 0
skinparam class {
  BackgroundColor #87CEEB
  BorderColor Black
  ArrowColor Black
}

' ================= LOP GIAO DIEN =================
class ManagerView {
  -outManagerInfo
  -subReceive
  -subAssign
  -subCalSalary
  -subBack
}

class SearchNeededServiceSlipView {
  -inServiceSlipKeyword
  -subSearch
  -subBack
  -subAssign
  -outServiceAndComponentList
}

class StaffListView {
  -outStaffListInfo
  -subConfirm
  -subBack
  -subChoose
}

class ChooseSlotView {
  -outSlotList
  -subChoose
  -subBack
}

' ================= LOP THUC THE =================
class User {
  -username
  -password
  -fullname
  -phone
  -email
}

class Manager {
  -employeeId
  -specialization
}

class Staff {
  -employeeId
  -specialization
  -bankAccount
  +getStaffList()
}

class Car {
  -licensePlate
  -brand
  -model
  -year
}

class Slot {
  -slotId
  -location
  -status
  +getAvailableSlots()
  +updateSlotStatus()
}

class ServiceSlip {
  -ssId
  -time
  -status
  -totalCost
  +findServiceSlipByKeyword()
  +updateServiceSlip()
}

class ServiceDetail {
  -price
  -laborContent
  -startedAt
  -finishedAt
  +assignStaffToServiceDetail()
}

class ComponentDetail {
  -qty
  -price
}

class Service {
  -name
  -price
  -laborContent
}

class Component {
  -name
  -price
  -inventoryQty
}

' ---- Ke thua ----
User <|-- Manager
User <|-- Staff

' ---- Quan he chua giua cac lop thuc the ----
ServiceSlip    "n" o-- "1" Car
ServiceSlip    "n" o-- "1" Manager
ServiceSlip    "n" o-- "1" Slot
ServiceSlip    "1" o-- "n" ServiceDetail
ServiceSlip    "1" o-- "n" ComponentDetail
ServiceDetail  "n" o-- "1" Service
ServiceDetail  "n" o-- "1" Staff
ComponentDetail "n" o-- "1" Component

' ---- Giao dien goi giao dien ----
ManagerView -- SearchNeededServiceSlipView
SearchNeededServiceSlipView -- StaffListView
StaffListView -- ChooseSlotView
ChooseSlotView -- ManagerView

' ---- Giao dien goi lop thuc the ----
SearchNeededServiceSlipView -- ServiceSlip
SearchNeededServiceSlipView -- Service
SearchNeededServiceSlipView -- Component
StaffListView -- Staff
StaffListView -- ServiceDetail
ChooseSlotView -- Slot
ChooseSlotView -- ServiceSlip

@enduml
